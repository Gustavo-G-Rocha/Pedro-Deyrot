# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# No Railway isso e injetado automaticamente ao adicionar o plugin Postgres.
# Localmente, use a DATABASE_PUBLIC_URL da aba Variables do servico Postgres.
DATABASE_URL=postgresql://usuario:senha@host:5432/railway

# ---------------------------------------------------------------------------
# Autenticacao do admin (substitui o Firebase Auth)
# ---------------------------------------------------------------------------
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-aleatoria-longa

# Criados/atualizados automaticamente no boot do servidor.
# Depois do primeiro deploy, voce pode remover ADMIN_PASSWORD das variaveis.
ADMIN_EMAIL=seu@email.com
ADMIN_PASSWORD=uma-senha-forte

# ---------------------------------------------------------------------------
# Integracoes opcionais
# ---------------------------------------------------------------------------
# Espelha os formularios numa planilha do Google. Sem isso o site funciona igual.
GOOGLE_SHEETS_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Apenas para rodar `npm run migrar` (copia os dados do Firebase)
# ---------------------------------------------------------------------------
# Alternativa ao arquivo ./firebase-service-account.json:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_STORAGE_BUCKET=deyrot-e4381.firebasestorage.app
