rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Função auxiliar para verificar se usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Função para validar tamanho do arquivo (máximo 10MB)
    function validSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }
    
    // Pasta 'eventos/' - Imagens dos eventos
    match /eventos/{fileName} {
      // Apenas usuários autenticados podem fazer upload
      allow create: if isAuthenticated() && validSize() && 
                      request.resource.contentType.matches('image/.*');
      
      // Leitura pública
      allow read: if true;
      
      // Apenas usuários autenticados podem deletar
      allow delete: if isAuthenticated();
    }
    
    // Pasta 'denuncias/' - PDFs das denúncias
    match /denuncias/{fileName} {
      // Apenas usuários autenticados podem fazer upload
      allow create: if isAuthenticated() && validSize() && 
                      request.resource.contentType == 'application/pdf';
      
      // Leitura pública
      allow read: if true;
      
      // Apenas usuários autenticados podem deletar
      allow delete: if isAuthenticated();
    }

    // Pasta 'denuncias/imagens/' - Imagens de capa das denúncias
    match /denuncias/imagens/{fileName} {
      // Apenas usuários autenticados podem fazer upload de imagens
      allow create: if isAuthenticated() && validSize() && 
                      request.resource.contentType.matches('image/.*');
      
      // Leitura pública
      allow read: if true;
      
      // Apenas usuários autenticados podem deletar
      allow delete: if isAuthenticated();
    }
    
    // Pasta 'campanhas/' - Imagens das campanhas
    match /campanhas/{fileName} {
      // Apenas usuários autenticados podem fazer upload
      allow create: if isAuthenticated() && validSize() && 
                      request.resource.contentType.matches('image/.*');
      
      // Leitura pública
      allow read: if true;
      
      // Apenas usuários autenticados podem deletar
      allow delete: if isAuthenticated();
    }
    
    // Bloquear acesso a qualquer outro caminho
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
